{
  "convo-mesh-coordinator": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 hooks/mesh_hook.py",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 hooks/mesh_hook.py",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/mesh_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 hooks/mesh_hook.py",
        "timeout": 10
      }
    ]
  }
}
